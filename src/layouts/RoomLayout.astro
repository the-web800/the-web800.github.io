---
import ElevatorIcon from "../components/elevator/ElevatorIcon.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
import Layout from "./Layout.astro";

interface Props {
	title: string;
	// B1は0になる
	floor: string;
	fixed?: boolean;
	top: string;
	noHeaderH1?: boolean;
}
const { title, floor, fixed = true, top, noHeaderH1 = false } = Astro.props;
---

<Layout {title}>
	<div class="flex flex-col min-h-svh">
		<Header title={title} fixed={fixed} {top} {noHeaderH1} />
		<div class="fixed bottom-0 right-0 z-50">
			<ElevatorIcon {floor} />
		</div>
		<div class="flex-1 flex flex-col">
			<slot />
		</div>
		<Footer />
	</div>
</Layout>
