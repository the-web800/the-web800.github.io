---
import WorkList from "../../components/WorkList.astro";
import RoomLayout from "../../layouts/RoomLayout.astro";
import { works as allWorks } from "../../lib/works";

const works = allWorks
	.filter((data) => data.dir === "studio")
	.map((data) => data.work);
---

<RoomLayout title="Studio" floor="2" top="/studio">
	<main class="flex flex-col items-center">
		<div class="w-full max-w-6xl p-5">
			<WorkList {works} />
		</div>
	</main>
</RoomLayout>
