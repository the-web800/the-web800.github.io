---
import { Image } from "astro:assets";
import type { Work } from "../lib/works";
import InternalLink from "./links/InternalLink.astro";

type Props = {
	work: Work;
};
const { work } = Astro.props;
const href = work.id.startsWith("/") ? work.id : `/works/${work.id}`;
---

<article
	class="group relative flex flex-col overflow-hidden rounded-lg border bg-stone-50 border-gray-300 motion-safe:hover:outline-1 outline-cyan-400 motion-safe:hover:-translate-y-1 hover:shadow-md transition-transform"
>
	<div class="aspect-4/3 overflow-hidden">
		<Image
			src={work.img}
			alt={work.title}
			class="w-full h-full object-cover motion-safe:group-hover:scale-105 transition-transform"
		/>
	</div>
	<div class="p-4 flex flex-col gap-2">
		<a
			href={href}
			class="after:absolute after:inset-0 focus-visible:outline-none"
		>
			<p class="font-bold text-lg">{work.title}</p>
		</a>
		<p class="z-10">
			{work.description}
		</p>
		{work.post && (
			<InternalLink href={work.post} class="z-10 text-sm">
				紹介したポストを見る
			</InternalLink>
		)}
		<div class="w-full flex flex-wrap gap-1 pt-2 border-t border-gray-300">
			{work.tags.map((tag) => (
				<div class="z-10 text-sm text-gray-700 font-semibold px-2 border-2 border-gray-400 bg-slate-200 rounded-lg hover:border-gray-500">
					{/* <a href={`/search?tags=${tag}&category=works`}>{tag}</a> */}
					{tag}
				</div>
			))}
		</div>
	</div>
</article>
